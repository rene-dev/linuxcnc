loadrt mux4 count=1
loadrt lowpass
loadrt encoder num_chan=1

setp lowpass.0.gain 0.01

addf mux4.0 servo-thread
addf lowpass.0 servo-thread
addf encoder.update-counters servo-thread
addf encoder.capture-position servo-thread

net jog-x ppmc.0.din.06.in => joint.0.jog-enable
net jog-y ppmc.0.din.07.in => joint.1.jog-enable
net jog-z ppmc.0.din.08.in => joint.2.jog-enable

net x10   ppmc.0.din.09.in => mux4.0.sel0
net x100  ppmc.0.din.10.in => mux4.0.sel1

# jog-counts is a float pin, so lowpass passes the counts through unscaled
# (the old ilowpass here multiplied by 100, hence the 100x smaller values)
setp mux4.0.in1 .000025
setp mux4.0.in0 .00025
setp mux4.0.in2 .0025
setp mux4.0.in3 0

net jogscale mux4.0.out => joint.0.jog-scale
net jogscale            => joint.1.jog-scale
net jogscale            => joint.2.jog-scale

net mpg-a      ppmc.0.din.04.in => encoder.0.phase-A 
net mpg-b      ppmc.0.din.05.in => encoder.0.phase-B
net mpg-out encoder.0.counts-f => lowpass.0.in
 
net jogcounts lowpass.0.out            => joint.0.jog-counts
net jogcounts                         => joint.1.jog-counts
net jogcounts                         => joint.2.jog-counts
