loadusr -W pyvcp -c pyvcp vcp.xml

net estop-activate       pyvcp.estop.activate       halui.estop.activate
net estop-reset          pyvcp.estop.reset          halui.estop.reset
net estop-is-activated   pyvcp.estop.is-activated   halui.estop.is-activated

net machine-off          pyvcp.machine.off          halui.machine.off
net machine-on           pyvcp.machine.on           halui.machine.on
net machine-is-on        pyvcp.machine.is-on        halui.machine.is-on

net abort                pyvcp.abort                halui.abort

net run                  pyvcp.program.run          halui.program.run
net pause                pyvcp.program.pause        halui.program.pause
net resume               pyvcp.program.resume       halui.program.resume
net step                 pyvcp.program.step         halui.program.step

net mist-on              pyvcp.mist.on              halui.mist.on
net mist-off             pyvcp.mist.off             halui.mist.off
net flood-on             pyvcp.flood.on             halui.flood.on
net flood-off            pyvcp.flood.off            halui.flood.off

net mist-is-on           pyvcp.mist.is-on           halui.mist.is-on
net flood-is-on          pyvcp.flood.is-on          halui.flood.is-on

net mode-manual          pyvcp.mode.manual          halui.mode.manual
net mode-auto            pyvcp.mode.auto            halui.mode.auto  
net mode-mdi             pyvcp.mode.mdi             halui.mode.mdi   

net spindle-start        pyvcp.spindle.on           halui.spindle.0.start
net spindle-stop         pyvcp.spindle.off          halui.spindle.0.stop
net spindle-forward      pyvcp.spindle.forward      halui.spindle.0.forward
net spindle-reverse      pyvcp.spindle.reverse      halui.spindle.0.reverse
net spindle-increase     pyvcp.spindle.increase     halui.spindle.0.increase
net spindle-decrease     pyvcp.spindle.decrease     halui.spindle.0.decrease

net mode-is-manual       pyvcp.mode.is-manual       halui.mode.is-manual
net mode-is-auto         pyvcp.mode.is-auto         halui.mode.is-auto  
net mode-is-mdi          pyvcp.mode.is-mdi          halui.mode.is-mdi   

net spindle-is-on        pyvcp.spindle.is-on        halui.spindle.0.is-on
net spindle-is-forward   pyvcp.spindle.is-forward   halui.spindle.0.runs-forward
net spindle-is-backward  pyvcp.spindle.is-reverse   halui.spindle.0.runs-backward

net j0-home              pyvcp.x.home               halui.joint.0.home
net j0-is-homed          pyvcp.x.is-homed           halui.joint.0.is-homed
net j0-min-hard          pyvcp.x.min-hard           halui.joint.0.on-hard-min-limit
net j0-min-soft          pyvcp.x.min-soft           halui.joint.0.on-soft-min-limit
net j0-max-soft          pyvcp.x.max-soft           halui.joint.0.on-soft-max-limit
net j0-max-hard          pyvcp.x.max-hard           halui.joint.0.on-hard-max-limit
net j0-has-fault         pyvcp.x.has-fault          halui.joint.0.has-fault
net j0-minus             pyvcp.jog-x-               halui.joint.0.minus halui.axis.x.minus
net j0-plus              pyvcp.jog-x+               halui.joint.0.plus  halui.axis.x.plus

net j1-home              pyvcp.y.home               halui.joint.1.home
net j1-is-homed          pyvcp.y.is-homed           halui.joint.1.is-homed
net j1-min-hard          pyvcp.y.min-hard           halui.joint.1.on-hard-min-limit
net j1-min-soft          pyvcp.y.min-soft           halui.joint.1.on-soft-min-limit
net j1-max-soft          pyvcp.y.max-soft           halui.joint.1.on-soft-max-limit
net j1-max-hard          pyvcp.y.max-hard           halui.joint.1.on-hard-max-limit
net j1-has-fault         pyvcp.y.has-fault          halui.joint.1.has-fault
net j1-minus             pyvcp.jog-y-               halui.joint.1.minus halui.axis.y.minus
net j1-plus              pyvcp.jog-y+               halui.joint.1.plus  halui.axis.y.plus

net j2-home              pyvcp.z.home               halui.joint.2.home
net j2-is-homed          pyvcp.z.is-homed           halui.joint.2.is-homed
net j2-min-hard          pyvcp.z.min-hard           halui.joint.2.on-hard-min-limit
net j2-min-soft          pyvcp.z.min-soft           halui.joint.2.on-soft-min-limit
net j2-max-soft          pyvcp.z.max-soft           halui.joint.2.on-soft-max-limit
net j2-max-hard          pyvcp.z.max-hard           halui.joint.2.on-hard-max-limit
net j2-has-fault         pyvcp.z.has-fault          halui.joint.2.has-fault
net j2-minus             pyvcp.jog-z-               halui.joint.2.minus halui.axis.z.minus
net j2-plus              pyvcp.jog-z+               halui.joint.2.plus  halui.axis.z.plus

net fo-increase          pyvcp.feed-override+       halui.feed-override.increase
net fo-decrease          pyvcp.feed-override-       halui.feed-override.decrease
net fo-value             pyvcp.feed-override.value  halui.feed-override.value

net so-increase          pyvcp.spindle-override+    halui.spindle.0.override.increase
net so-decrease          pyvcp.spindle-override-    halui.spindle.0.override.decrease
net so-value             pyvcp.spindle-override.value  halui.spindle.0.override.value

net os-on                pyvcp.optional-stop.on     halui.program.optional-stop.on
net os-off               pyvcp.optional-stop.off    halui.program.optional-stop.off
net os-is-on             pyvcp.optional-stop.is-on  halui.program.optional-stop.is-on

net bd-on                pyvcp.block-delete.on      halui.program.block-delete.on
net bd-off               pyvcp.block-delete.off     halui.program.block-delete.off
net bd-is-on             pyvcp.block-delete.is-on   halui.program.block-delete.is-on

#net probe-button         pyvcp.probe                motion.probe-input

net quill-up             pyvcp.quillup              halui.mdi-command-00
net reference-pos        pyvcp.referencepos         halui.mdi-command-01

net jogspeed             pyvcp.jog-speed            halui.joint.jog-speed halui.axis.jog-speed

# jog setup: held by task and shared with the GUI. The panel's spinboxes
# set it, the "in task" numbers show what task holds, whoever set it last.
net jog-speed-value      halui.axis.jog-speed.value          => pyvcp.jog-speed.value
net jog-aspeed           pyvcp.jog-speed-angular             => halui.axis.jog-speed-angular
net jog-aspeed-value     halui.axis.jog-speed-angular.value  => pyvcp.jog-speed-angular.value
net jog-incr             pyvcp.jog-increment                 => halui.axis.jog-increment
# the selected joint/axis jogs by the shared increment
net jog-incr-value       halui.axis.jog-increment.value      => pyvcp.jog-increment.value halui.axis.selected.increment halui.joint.selected.increment

net mode-joint           pyvcp.mode.joint           halui.mode.joint
net mode-teleop          pyvcp.mode.teleop          halui.mode.teleop
net mode-is-joint        pyvcp.mode.is-joint        halui.mode.is-joint
net mode-is-teleop       pyvcp.mode.is-teleop       halui.mode.is-teleop
net home-all             pyvcp.home-all             halui.home-all

net j0-select            pyvcp.joint.0.select       halui.joint.0.select
net j1-select            pyvcp.joint.1.select       halui.joint.1.select
net j2-select            pyvcp.joint.2.select       halui.joint.2.select
net j0-is-selected       pyvcp.joint.0.is-selected  halui.joint.0.is-selected
net j1-is-selected       pyvcp.joint.1.is-selected  halui.joint.1.is-selected
net j2-is-selected       pyvcp.joint.2.is-selected  halui.joint.2.is-selected
net joint-selected       pyvcp.joint.selected       halui.joint.selected

net x-select             pyvcp.axis.x.select        halui.axis.x.select
net y-select             pyvcp.axis.y.select        halui.axis.y.select
net z-select             pyvcp.axis.z.select        halui.axis.z.select
net x-is-selected        pyvcp.axis.x.is-selected   halui.axis.x.is-selected
net y-is-selected        pyvcp.axis.y.is-selected   halui.axis.y.is-selected
net z-is-selected        pyvcp.axis.z.is-selected   halui.axis.z.is-selected
net aux0-select          pyvcp.jog-aux.0.select     halui.jog-aux.0.select
net aux0-is-selected     pyvcp.jog-aux.0.is-selected halui.jog-aux.0.is-selected
net axis-selected        pyvcp.axis.selected        halui.axis.selected

net jog-selected-minus   pyvcp.jog-selected-        halui.joint.selected.minus halui.axis.selected.minus
net jog-selected-plus    pyvcp.jog-selected+        halui.joint.selected.plus  halui.axis.selected.plus
net jog-sel-incr-minus   pyvcp.jog-selected-incr-   halui.joint.selected.increment-minus halui.axis.selected.increment-minus
net jog-sel-incr-plus    pyvcp.jog-selected-incr+   halui.joint.selected.increment-plus  halui.axis.selected.increment-plus

net ro-increase          pyvcp.rapid-override+      halui.rapid-override.increase
net ro-decrease          pyvcp.rapid-override-      halui.rapid-override.decrease
net ro-value             pyvcp.rapid-override.value halui.rapid-override.value

# max-velocity.scale defaults to 0, so increase/decrease would do nothing
setp halui.max-velocity.scale 0.1
net mv-increase          pyvcp.max-velocity+        halui.max-velocity.increase
net mv-decrease          pyvcp.max-velocity-        halui.max-velocity.decrease
net mv-value             pyvcp.max-velocity.value   halui.max-velocity.value
